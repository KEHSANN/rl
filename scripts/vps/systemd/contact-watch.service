# Optional systemd user unit for the watcher (see contact-train@.service).
# Start it only after training has created its run dir: `--run latest` is
# resolved once at startup. Exit code 3 = another watcher already holds the
# run's lock; that is not a failure, so it is not restarted.
[Unit]
Description=contact-rl checkpoint watcher
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/rl
Environment=MUJOCO_GL=egl
Environment=PYOPENGL_PLATFORM=egl
ExecStart=%h/.local/bin/uv run contact-watch --run latest --interval-s 120
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=900
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=3

[Install]
WantedBy=default.target
